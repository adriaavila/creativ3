# Shared Neon database
DATABASE_URL=

# Clerk for /ops/growth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Meta WhatsApp Embedded Signup / Coexistence
APP_URL=https://allok.fun
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_CONFIG_ID_CLOUD_API=
META_GRAPH_VERSION=v25.0
META_WEBHOOK_CALLBACK_URL=https://allok.fun/api/meta/whatsapp/webhook
META_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
N8N_WEBHOOK_URL=https://n8n.frontia.app/webhook/meta/embedded-signup
N8N_WEBHOOK_SECRET=
N8N_WHATSAPP_EVENTS_WEBHOOK_URL=https://n8n.frontia.app/webhook/meta/whatsapp-events
GROWTH_OUTREACH_WEBHOOK_URL=https://n8n.frontia.app/webhook/ops/growth-outreach
NEXT_PUBLIC_APP_URL=https://allok.fun
NEXT_PUBLIC_META_APP_ID=
# Entrega de clientes que trabajan en REI CRM (residente). Ver
# docs/allok-whatsapp/ONBOARDING-CLIENTES.md.
REI_PROVISION_URL=https://app.reiprop.tech/api/whatsapp/provision
REI_PROVISION_SECRET=             # 32+ chars; igual a WHATSAPP_PROVISION_SECRET en REI
REI_WEBHOOK_VERIFY_TOKEN=         # igual a WHATSAPP_WEBHOOK_VERIFY_TOKEN en REI; Meta lo valida al redirigir el webhook
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v25.0

# Private web -> Eve service connection
GROWTH_AGENT_RUNTIME=eve
GROWTH_AGENT_URL=
GROWTH_AGENT_USERNAME=
GROWTH_AGENT_PASSWORD=

# --- apps/growth-agent/.env (separate deploy) ---
# DATABASE_URL=                 # same Neon DB
# GROWTH_AGENT_USERNAME=        # must match the values above
# GROWTH_AGENT_PASSWORD=
# AI_GATEWAY_API_KEY=           # Vercel AI Gateway; alternatively use Vercel OIDC
# GROWTH_MODEL=anthropic/claude-sonnet-4-6

# Social publishing and analytics (server-side only)
POSTIZ_API_URL=https://api.postiz.com
POSTIZ_API_KEY=
POSTIZ_DEFAULT_INTEGRATION=
POSTIZ_REVIEW_HOURS=48

# WAHA sidecar: WhatsApp Status/Channels, never expose the key to the browser
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_API_KEY_HASH=sha512:
WAHA_SESSION=default
WAHA_WEBHOOK_URL=
WAHA_WEBHOOK_HMAC_KEY=

# Safe pilot gate. In `pilot`, every outbound path (Growth, Inbox and AI) is
# blocked unless the destination is listed as E.164 digits, comma-separated.
WHATSAPP_OUTBOUND_MODE=pilot
WHATSAPP_PILOT_ALLOWED_WA_IDS=

# Live CRM behavior check: a WAHA-linked tester number writes to the CRM line.
WAHA_CRM_TESTER_SESSION=
WAHA_CRM_TEST_TARGET=
WAHA_CRM_TEST_CONFIRM=

# Approved Meta template used for first-contact Growth outreach.
WHATSAPP_GROWTH_TEMPLATE_NAME=allok_growth_intro
WHATSAPP_GROWTH_TEMPLATE_LANGUAGE=es

# Hermes Agent gateway (migration target for the Eve growth agent)
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=
HERMES_MODEL=

# Durable weekly learning notes
BRAIN_GITHUB_TOKEN=
BRAIN_REPO=
BRAIN_DIR=growth
# Private allok Ops access (replaces Clerk for /ops)
OPS_ACCESS_PASSWORD=
OPS_SESSION_SECRET=

# Ops realtime token and signed Vercel -> Coolify event bridge.
REALTIME_TOKEN_SECRET=
REALTIME_INGEST_URL=https://realtime.allok.fun/internal/events
REALTIME_INGEST_SECRET=
NEXT_PUBLIC_REALTIME_URL=wss://realtime.allok.fun

# GitHub PAT (repo + workflow scopes) that dispatches the "Sync portafolio"
# Action from /ops/portfolio. Same token also goes in creativ3's GitHub repo
# secrets as PORTFOLIO_SYNC_TOKEN, where the workflow uses it to read
# pushed_at on private project repos.
PORTFOLIO_SYNC_TOKEN=
PORTFOLIO_SYNC_REPO=adriaavila/creativ3

# AES-256-GCM key for whatsapp_connections.business_token at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Stripe checkout + purchase webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="allok <pagos@your-domain.com>"
STRIPE_PRODUCT_LAUNCH=
STRIPE_PRICE_LAUNCH=
STRIPE_PRODUCT_AUTOMATE=
STRIPE_PRICE_AUTOMATE=
STRIPE_PRODUCT_DESK=
STRIPE_PRICE_DESK_COHORT_MONTHLY=
STRIPE_PRICE_DESK_COHORT_SETUP=
STRIPE_PRICE_DESK_MONTHLY=
STRIPE_PRICE_DESK_SETUP=
STRIPE_PRICE_DESK_SCALE_MONTHLY=
STRIPE_PRICE_DESK_SCALE_SETUP=

# WhatsApp AI auto-reply routing (Vercel AI Gateway, plain provider/model strings)
WHATSAPP_AI_FAQ_MODEL=anthropic/claude-haiku-4-5
WHATSAPP_AI_QUALIFY_MODEL=anthropic/claude-sonnet-5
# Optional approved Meta template with one {{1}} body variable for replies outside 24h.
WHATSAPP_AUTO_REPLY_TEMPLATE_NAME=
WHATSAPP_AUTO_REPLY_TEMPLATE_LANGUAGE=es
